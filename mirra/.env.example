# Optional. Without a key, MIRRA runs in clearly labelled demo mode.
OPENAI_API_KEY=

# OpenAI-compatible API base URL. For a relay service, use its /v1 URL.
OPENAI_BASE_URL=https://api.openai.com/v1

# Override these only if your API project exposes different current values.
OPENAI_MODEL=auto
OPENAI_API_MODE=auto
OPENAI_WEB_SEARCH_TOOL=web_search
OPENAI_SEARCH_MODEL=
OPENAI_REASONING_EFFORT=low

# Cloudflare Turnstile. Create these at dash.cloudflare.com > Turnstile.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_REQUIRED=true
TURNSTILE_EXPECTED_HOSTNAME=

# Optional persistent rate limiting (recommended on Vercel).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
AI_RATE_LIMIT_MAX=6
AI_RATE_LIMIT_WINDOW_SECONDS=3600
